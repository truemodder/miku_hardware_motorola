# DMA Latency
allow hal_power_default vendor_latency_device:file rw_file_perms;
allow hal_power_default vendor_latency_device:chr_file rw_file_perms;

# Touchpanel
r_dir_file(hal_power_default, vendor_sysfs_touchpanel)
allow hal_power_default vendor_sysfs_touchpanel:file rw_file_perms;

# Sensors
allow hal_power_default vendor_sysfs_sensors:dir search;
r_dir_file(hal_power_default, vendor_sysfs_input)
allow hal_power_default vendor_sysfs_input:file rw_file_perms;
